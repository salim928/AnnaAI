# =============================================================================
# AnnaAi Backend — environment variables
# Copy to `.env` (next to this file) and fill in the values you have.
# Only SUPABASE_* and ANTHROPIC_API_KEY are strictly required to run the agent.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=AnnaAi
APP_VERSION=0.1.0
ENVIRONMENT=development              # development | staging | production
DEBUG=true
SECRET_KEY=                          # random 32+ byte string, used for JWT
ENCRYPTION_KEY=                      # 32-byte urlsafe Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=                        # https://xxxx.supabase.co
SUPABASE_ANON_KEY=                   # public anon key (frontend + server)
SUPABASE_SERVICE_ROLE_KEY=           # server-only, full access
SUPABASE_DB_URL=                     # postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres

# --- Anthropic / Claude -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# --- Local embeddings (no API key) ------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Resend email -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=anna@annaai.app
RESEND_FROM_NAME=Anna · AnnaAi

# --- URLs -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Google OAuth (GA4 + Search Console) ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Image generation — Pollinations is free, no key -----------------------
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
POLLINATIONS_WIDTH=1200
POLLINATIONS_HEIGHT=630

# --- Redis / Upstash --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Scheduler --------------------------------------------------------------
SCHEDULER_SECRET=                    # shared secret for GitHub Actions → /api/scheduler

# --- Scraping ---------------------------------------------------------------
SCRAPE_MAX_PAGES=20
SCRAPE_TIMEOUT_SECONDS=30

# --- Plan limits ------------------------------------------------------------
MAX_RUNS_PER_DAY_FREE=1
MAX_DRAFTS_PER_RUN_FREE=3
MAX_DRAFTS_PER_RUN_PRO=10

# --- Paystack (Batch 6) -----------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Sentry error tracking --------------------------------------------------
SENTRY_DSN=                          # https://xxxxx@xxx.ingest.sentry.io/xxxxx
